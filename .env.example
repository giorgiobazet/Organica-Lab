# Modelo de variáveis de ambiente do site (todas públicas: vão para o navegador).
# O .env versionado já traz a configuração web do Firebase, que é pública por design
# (a proteção dos dados está em firestore.rules, storage.rules e no Firebase Auth).
# Nunca coloque aqui chaves privadas, JSON de conta de serviço ou tokens: o prefixo
# NEXT_PUBLIC_ publica o valor no site.
#
# Para testar o Modo Dev local, copie para .env.local e deixe as variáveis vazias.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (opcional): chave do site do reCAPTCHA Enterprise. Ao ativar, inclua na CSP do
# firebase.json: script-src https://www.google.com https://www.gstatic.com;
# frame-src https://www.google.com; connect-src https://content-firebaseappcheck.googleapis.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Só para testes locais com os emuladores do Firebase (nunca no build publicado).
NEXT_PUBLIC_FIREBASE_EMULADOR=
