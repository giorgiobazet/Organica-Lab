# Configuração pública do app web Firebase (projeto chempharm-hub).
# Estas chaves identificam o projeto e ficam visíveis no site publicado; a segurança
# dos dados está nas regras do Firestore (firestore.rules) e no Firebase Auth.
# Para testar o Modo Dev local, sobrescreva com variáveis vazias num .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAydQjSwS52C3ZxldURg2OGqIXwlavcxc8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=chempharm-hub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=chempharm-hub
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=chempharm-hub.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=842359572429
NEXT_PUBLIC_FIREBASE_APP_ID=1:842359572429:web:29d0fbc2b69818508fe684

# Vazias no site publicado: o build elimina o código de App Check e de emuladores.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_FIREBASE_EMULADOR=
