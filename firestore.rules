rules_version = '2';

// Cada usuário (aluno ou servidor) lê e escreve apenas o próprio perfil.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'matricula', 'perfil', 'xp', 'progresso'])
        && request.resource.data.matricula is string
        // Perfil coerente com o formato: aluno = 12 dígitos; servidor (professor/técnico) = 00000-0.
        // O perfil só identifica o usuário: nenhuma regra concede acesso extra a servidores.
        && ((request.resource.data.matricula.matches('^[0-9]{12}$') && request.resource.data.perfil == 'aluno')
          || (request.resource.data.matricula.matches('^[0-9]{5}-[0-9]$') && request.resource.data.perfil == 'servidor'))
        && request.resource.data.xp == 0;

      allow read: if request.auth != null && request.auth.uid == uid;

      // Progresso e XP só depois do e-mail verificado; nome, e-mail e matrícula ficam imutáveis.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'progresso'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
